{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar-det-ko-till-hono",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Each `wrangler versions upload` stages a new version under a unique
  // `<short-id>-<name>.<account>.workers.dev` URL — public but unguessable.
  // PR previews (.github/workflows/preview.yml → env.preview) rely on this;
  // production inherits it so a freshly uploaded version can be smoke-tested
  // at its own URL before traffic flips, and a one-click rollback is always
  // a known-good version URL away.
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // KV namespace caches the queue status per direction.
  // Create one with: wrangler kv namespace create QUEUE_CACHE
  "kv_namespaces": [
    {
      "binding": "QUEUE_CACHE",
      "id": "2d33fc56cb964089a8944d9a0c0a88f6",
      "preview_id": "2af300bd77ce47a98da79c8d82d392fa"
    }
  ],
  // GOOGLE_MAPS_API_KEY is stored as a secret, not a var.
  // Set it with: wrangler secret put GOOGLE_MAPS_API_KEY
  // For local dev, drop it in .dev.vars (gitignored).
  // ASCII domains are the canonical homes. IDN domains stay bound to the
  // worker so they can serve a 301 redirect to the ASCII apex (handled in
  // src/server/canonical.ts and consumed by the SSR handlers).
  // Cloudflare's API stores IDN zones in Punycode; use the Punycode form.
  "routes": [
    {
      "pattern": "ardetkotillhono.se",
      "custom_domain": true
    },
    {
      "pattern": "www.ardetkotillhono.se",
      "custom_domain": true
    },
    {
      "pattern": "ardetkotillvarholmen.se",
      "custom_domain": true
    },
    {
      "pattern": "www.ardetkotillvarholmen.se",
      "custom_domain": true
    },
    {
      "pattern": "xn--rdetktillhn-k8a3vfb.se",
      "custom_domain": true
    },
    {
      "pattern": "www.xn--rdetktillhn-k8a3vfb.se",
      "custom_domain": true
    },
    {
      "pattern": "xn--rdetktillvarholmen-ktb97a.se",
      "custom_domain": true
    },
    {
      "pattern": "www.xn--rdetktillvarholmen-ktb97a.se",
      "custom_domain": true
    }
  ],
  // Per-PR preview env. `wrangler versions upload --env preview` (via
  // .github/workflows/preview.yml on every PR open/push) stages a new
  // version of this Worker under a unique workers.dev URL. No custom_domain
  // routes here — preview traffic stays off the production zones. KV
  // bindings don't inherit across envs, so the preview namespace id is
  // repeated explicitly (it was the top-level `preview_id`).
  "env": {
    "preview": {
      "name": "ar-det-ko-till-hono-preview",
      // Explicitly empty so the production custom_domain routes can't leak
      // into a preview deploy. `wrangler versions upload --env preview`
      // stages a version but doesn't take routes until promoted, but empty
      // here is the safer default.
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "QUEUE_CACHE",
          "id": "2af300bd77ce47a98da79c8d82d392fa"
        }
      ]
    }
  }
}
