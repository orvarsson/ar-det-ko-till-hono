<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dc="http://schema.data.trafikverket.se/dc1.0.xsd">
  <xs:annotation>
    <xs:documentation xml:lang="sv">Information om färjeleder.</xs:documentation>
    <xs:documentation xml:lang="en">Information about ferry routes.</xs:documentation>
  </xs:annotation>
  <xs:element name="RESPONSE" type="RESPONSE" />
  <xs:complexType name="RESPONSE">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="RESULT" type="RESULT" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RESULT">
    <xs:sequence>
      <xs:element maxOccurs="unbounded" name="FerryRoute" type="FerryRoute" minOccurs="0" />
      <xs:element minOccurs="0" name="ERROR" type="ERROR" />
      <xs:element minOccurs="0" name="INFO" type="INFO" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="ERROR">
    <xs:sequence>
      <xs:element name="SOURCE" type="xs:string" minOccurs="0" />
      <xs:element name="MESSAGE" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LASTMODIFIED">
    <xs:attribute name="datetime" type="xs:dateTime" use="optional" />
  </xs:complexType>
  <xs:complexType name="EVALRESULT">
    <xs:sequence>
      <xs:any minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="INFO">
    <xs:sequence>
      <xs:element name="LASTMODIFIED" type="LASTMODIFIED" minOccurs="0" />
      <xs:element name="LASTCHANGEID" type="xs:string" minOccurs="0" />
      <xs:element name="EVALRESULT" type="EVALRESULT" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="SSEURL" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FerryRoute">
    <xs:sequence>
      <xs:element ref="Deleted" minOccurs="0" />
      <xs:element name="DeviationId" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Referens till Deviation.Id i objektet Situation</xs:documentation>
          <xs:documentation xml:lang="en">Reference to Deviation.Id in the Situation object</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Geometry" type="Geometry" minOccurs="0" />
      <xs:element dc:key="true" name="Id" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ledens id</xs:documentation>
          <xs:documentation xml:lang="en">Trail ID</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ledens namn</xs:documentation>
          <xs:documentation xml:lang="en">Name of the trail</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Shortname" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Förkortning av ledens namn</xs:documentation>
          <xs:documentation xml:lang="en">Abbreviation of the name of the trail</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Type" type="Type" minOccurs="0" />
      <xs:element maxOccurs="unbounded" name="Harbor" type="Harbor" minOccurs="0" />
      <xs:element maxOccurs="unbounded" name="Timetable" type="Timetable" minOccurs="0" />
      <xs:element name="ModifiedTime" type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="en">
        Specifies when the object is stored.
      </xs:documentation>
          <xs:documentation xml:lang="sv">
        Anger när objektet är sparat.
      </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="QueueAttributes" />
  </xs:complexType>
  <xs:element default="false" name="Deleted" type="xs:boolean">
    <xs:annotation>
      <xs:documentation xml:lang="en">
				Specifies if the object is deleted.
			</xs:documentation>
      <xs:documentation xml:lang="sv">
				Anger om objektet är raderat.
			</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="Geometry">
    <xs:sequence>
      <xs:element name="SWEREF99TM" type="WKT-SWEREF99TM-3D" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Geometrisk punkt i koordinatsystem SWEREF99TM</xs:documentation>
          <xs:documentation xml:lang="en">Geometric point in coordinate system SWEREF99TM</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WGS84" type="WKT-WGS84-3D" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Geometrisk punkt i koordinatsystem WGS84</xs:documentation>
          <xs:documentation xml:lang="en">Geometric point in coordinate system WGS84</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Type">
    <xs:sequence>
      <xs:element name="Id" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ledtypens id</xs:documentation>
          <xs:documentation xml:lang="en">Led type ID</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Ledtypens namn</xs:documentation>
          <xs:documentation xml:lang="en">Name of the joint type</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Harbor">
    <xs:sequence>
      <xs:element name="Id" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Hamnens id</xs:documentation>
          <xs:documentation xml:lang="en">Port ID</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Hamnens namn</xs:documentation>
          <xs:documentation xml:lang="en">Name of the port</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SortOrder" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Sorteringsordning</xs:documentation>
          <xs:documentation xml:lang="en">Sort order</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="StopType" type="StopType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Timetable">
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Tidtabellens beskrivning</xs:documentation>
          <xs:documentation xml:lang="en">Description of the timetable</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Priority" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Tidtabellens prioritet, det kan finnas flera tidtabeller som är giltiga samma datum, den med högst prioritet gäller.</xs:documentation>
          <xs:documentation xml:lang="en">The priority of the timetable, there may be several timetables valid on the same date, the one with the highest priority applies.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element maxOccurs="unbounded" name="Valid" type="Valid" minOccurs="0" />
      <xs:element maxOccurs="unbounded" name="Period" type="Period" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:attributeGroup name="QueueAttributes">
    <xs:attribute name="checkoutid" type="xs:string" use="optional" />
    <xs:attribute name="checkouts" type="xs:integer" use="optional" />
    <xs:attribute name="leaseduntil" type="xs:dateTime" use="optional" />
    <xs:attribute name="acknowledged" type="xs:dateTime" use="optional" />
    <xs:attribute name="statuscode" type="xs:unsignedByte" use="optional" />
    <xs:attribute name="itemsacknowledged" type="xs:long" use="optional" />
    <xs:attribute name="itemsleft" type="xs:long" use="optional" />
  </xs:attributeGroup>
  <xs:simpleType name="WKT-SWEREF99TM-3D">
    <xs:annotation>
      <xs:documentation xml:lang="en">
				Specifies a well known text in SWEREF99 format.
				The coordinate order is in X Y Z, where Z is optional.
			</xs:documentation>
      <xs:documentation xml:lang="sv">
				Anger en well known text i SWEREF99-format.
				Koordinaternas ordning anges i X Y Z, där Z är frivillig.
			</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(POINT|LINESTRING|MULTILINESTRING|POLYGON|MULTIPOLYGON)\s?\(.*\)" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="WKT-WGS84-3D">
    <xs:annotation>
      <xs:documentation xml:lang="en">
				Specifies a well known text in WGS84 format.
				The coordinate order is in X Y Z, where Z is optional.
			</xs:documentation>
      <xs:documentation xml:lang="sv">
				Anger en well known text i WGS84-format.
				Koordinaternas ordning anges i X Y Z, där Z är frivillig.
			</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(POINT|LINESTRING|MULTILINESTRING|POLYGON|MULTIPOLYGON)\s?\(.*\)" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="StopType">
    <xs:sequence>
      <xs:element name="Id" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Stopptypens id</xs:documentation>
          <xs:documentation xml:lang="en">Stop type ID</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Namn på stopptypen. Det finns tre olika "Avg", "Ank/Avg" &amp; "Ank"</xs:documentation>
          <xs:documentation xml:lang="en">Name of the stop type. There are three different "Avg", "Ank/Avg" &amp; "Ank"</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Visible" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">De med värdet true är synliga i tidtabellen</xs:documentation>
          <xs:documentation xml:lang="en">Those with a value of true are visible in the timetable</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Valid">
    <xs:sequence>
      <xs:element name="From" type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Datumet då tidtabellen börjar gälla</xs:documentation>
          <xs:documentation xml:lang="en">The date on which the timetable takes effect</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="To" type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Datumet då tidtabellen slutar gälla</xs:documentation>
          <xs:documentation xml:lang="en">The date the timetable expires</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Period">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Periodens namn</xs:documentation>
          <xs:documentation xml:lang="en">Name of the period</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SortOrder" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Periodens sorteringsordning</xs:documentation>
          <xs:documentation xml:lang="en">Sort order of the period</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element maxOccurs="unbounded" name="Weekday" type="Weekday" minOccurs="0" />
      <xs:element maxOccurs="unbounded" name="Schedule" type="Schedule" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Weekday">
    <xs:sequence>
      <xs:element name="Day" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Veckodagar som ingår i perioden (dagens namn)</xs:documentation>
          <xs:documentation xml:lang="en">Days of the week included in the period (day name)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Id" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Veckodagar som ingår i perioden (dagens id)</xs:documentation>
          <xs:documentation xml:lang="en">Days of the week included in the period  (day id)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Schedule">
    <xs:sequence>
      <xs:element maxOccurs="unbounded" name="Deviation" type="Deviation" minOccurs="0" />
      <xs:element name="Time" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Tidpunkt för händelse</xs:documentation>
          <xs:documentation xml:lang="en">Time of event</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Harbor" type="Harbor" minOccurs="0" />
      <xs:element name="SortOrder" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Sorteringsordning</xs:documentation>
          <xs:documentation xml:lang="en">Sort order</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="StopType" type="StopType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Deviation">
    <xs:sequence>
      <xs:element name="Description" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Beskrivning av avvikelsen</xs:documentation>
          <xs:documentation xml:lang="en">Description of the deviation</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Type" type="DeviationType" minOccurs="0" />
      <xs:element name="Id" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Avvikelsens id</xs:documentation>
          <xs:documentation xml:lang="en">The id of the deviation</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="FromDate" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Om avvikelsen gäller under en period så finns den en sträng fråndatum med formatet "mmdd"</xs:documentation>
          <xs:documentation xml:lang="en">If the deviation applies for a period, there is a string from date with the format "mmdd"</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ToDate" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Om avvikelsen gäller under en period så finns den en sträng slutdatum med formatet "mmdd"</xs:documentation>
          <xs:documentation xml:lang="en">If the deviation applies for a period, there is a string end date with the format "mmdd"</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SpecDate" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Om avvikelsen gäller specifika datum läggs de till en sträng med formatet "mmdd, mmdd"</xs:documentation>
          <xs:documentation xml:lang="en">If the discrepancy applies to specific dates, they are added to a string with the format "mmdd, mmdd</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DeviationType">
    <xs:sequence>
      <xs:element name="Id" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Avvikelsetypens id</xs:documentation>
          <xs:documentation xml:lang="en">Anomaly type ID</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="sv">Avvikelsetypens namn, det finns fyra: "Meddelande", "Kallelse", "Går" &amp; "Går ej"</xs:documentation>
          <xs:documentation xml:lang="en">The name of the deviation type, there are four: "Meddelande", "Kallelse", "Går" &amp; "Går ej"</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>